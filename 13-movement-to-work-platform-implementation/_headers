# Cloudflare Pages response headers.

# Every page and file: safer defaults. The microphone stays allowed for this
# site only, because interview practice can record an answer.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)

# Fonts never change under the same name, so browsers can keep them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs and artwork: kept for a week, refreshed quietly after that.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
